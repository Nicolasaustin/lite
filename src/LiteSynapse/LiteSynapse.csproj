<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>LiteSynapse</AssemblyName>
    <RootNamespace>LiteSynapse</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Workstation GC: one small heap, no per-core heaps or GC threads. Freed segments go back to Windows
         instead of being kept for later, so the tray app's memory stays small between uses. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- Nothing here uses EventSource/ETW, hot reload or globalization data: leaving them out saves start-up
         work and a few MB of mapped data in every run. -->
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <!-- Precompiled native code: no JIT pause the first time a key or profile switch is handled. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Do not copy package API docs (.xml) next to the exe. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <!-- No empty satellite-language folders in the output. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS8632;CA1416;WFO1000</NoWarn>
  </PropertyGroup>
  <!-- Publishing (dotnet publish -c Release -r win-x64): one framework-dependent exe. WebView2Loader.dll is
       bundled into it and extracted on first use; the .NET Desktop Runtime must be installed. -->
  <PropertyGroup>
    <SelfContained>false</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The loader comes from the package's runtimes\win-*\native assets (bundled when publishing for a RID),
         not from the extra copies the WebView2 targets would add next to the exe. -->
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <!-- The HTML window (WebWindow loads it with NavigateToString). -->
    <EmbeddedResource Include="ui\index.html" LogicalName="LiteSynapse.ui.index.html" Condition="Exists('ui\index.html')" />
    <!-- The logo at each icon size (tools/icon/make-icon.py) for the window icons and the tray panel. -->
    <EmbeddedResource Include="icon\icon-*.png" LogicalName="LiteSynapse.%(Filename).png" />
    <!-- Run elevated by the Razer clean-up (RazerLeftovers.FindDriverScript looks in tools\ next to the exe). -->
    <None Update="tools\remove-razer-filter-drivers.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The WebView2 package also references its WPF control; this WinForms app does not use it. Removed before
       references are resolved, so it is neither compiled against nor copied (nor bundled into the exe). -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <Target Name="WarnMissingUi" BeforeTargets="Build" Condition="!Exists('ui\index.html')">
    <Warning Text="src/LiteSynapse/ui/index.html is missing: the app will open the classic window instead of the HTML window." />
  </Target>
</Project>
